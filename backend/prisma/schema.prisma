datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MovementType {
  IN              // Entrada de novo lote
  OUT_CONSUMPTION // Saída normal (FEFO automático)
  OUT_LOSS        // Baixa por perda, avaria ou vencimento
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String          @id @default(uuid())
  sku         String          @unique
  name        String
  unit        String          // Ex: "UN", "KG", "CX", "L"
  minStock    Int             @default(0)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  batches     Batch[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
}

model Batch {
  id              String              @id @default(uuid())
  batchCode       String
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  initialQuantity Int
  currentQuantity Int
  unitCostInCents Int                 // Ex: R$ 5,50 = 550 centavos
  expirationDate  DateTime            @db.Date
  createdAt       DateTime            @default(now())
  movementItems   StockMovementItem[]

  @@index([productId, expirationDate, currentQuantity])
}

model StockMovement {
  id            String              @id @default(uuid())
  type          MovementType
  productId     String
  product       Product             @relation(fields: [productId], references: [id])
  totalQuantity Int
  reason        String?
  items         StockMovementItem[]
  createdAt     DateTime            @default(now())
}

model StockMovementItem {
  id              String        @id @default(uuid())
  movementId      String
  movement        StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id])
  quantity        Int
  unitCostInCents Int
}